policy_module(seatd, 1.0)

########################################
#
# Declarations
#

type seatd_t;
type seatd_exec_t;
init_daemon_domain(seatd_t, seatd_exec_t)
init_nnp_daemon_domain(seatd_t)
# seatd may not have the same level as a client
mls_fd_share_all_levels(seatd_t)

type seatd_initrc_exec_t;
init_script_file(seatd_initrc_exec_t)

type seatd_runtime_t;
files_pid_file(seatd_runtime_t)

########################################
#
# Local policy
#

allow seatd_t self:capability { chown dac_override sys_admin sys_tty_config };
allow seatd_t self:fifo_file rw_fifo_file_perms;
allow seatd_t self:unix_stream_socket { accept listen };

allow seatd_t seatd_runtime_t:sock_file manage_sock_file_perms;
files_pid_filetrans(seatd_t, seatd_runtime_t, sock_file)

auth_use_nsswitch(seatd_t)

dev_rw_dri(seatd_t)
dev_rw_input_dev(seatd_t)

# seatd requires access to unallocated TTYs (e.g. /dev/tty0) to manage
# seat activation and VT handling for Wayland compositors.
term_use_unallocated_ttys(seatd_t)

# Fedora user-session TTYs are labeled user_tty_device_t.
userdom_use_user_ttys(seatd_t)

# allow seatd to create sock file under var_run_t dir.
allow seatd_t var_run_t:dir { add_name write remove_name };
allow seatd_t var_run_t:sock_file { create getattr setattr unlink };
