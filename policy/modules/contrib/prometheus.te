policy_module(prometheus, 1.0.0)

########################################
#
# Declarations
#

## <desc>
##	<p>
##	Allow Prometheus to connect to all TCP ports.
##	This is commonly needed for configured scrape targets,
##	service discovery, federation, and remote write/read.
##	</p>
## </desc>
gen_tunable(prometheus_can_network_connect, true)

type prometheus_t;
type prometheus_exec_t;
init_daemon_domain(prometheus_t, prometheus_exec_t)

type prometheus_etc_t;
files_config_file(prometheus_etc_t)

type prometheus_var_lib_t;
files_type(prometheus_var_lib_t)

type prometheus_unit_file_t;
systemd_unit_file(prometheus_unit_file_t)

########################################
#
# Local policy
#

allow prometheus_t self:process { getsched setsched signal };
allow prometheus_t self:fifo_file rw_fifo_file_perms;
allow prometheus_t self:tcp_socket create_stream_socket_perms;
allow prometheus_t self:udp_socket create_socket_perms;

allow prometheus_t prometheus_etc_t:dir list_dir_perms;
read_files_pattern(prometheus_t, prometheus_etc_t, prometheus_etc_t)
read_lnk_files_pattern(prometheus_t, prometheus_etc_t, prometheus_etc_t)

manage_dirs_pattern(prometheus_t, prometheus_var_lib_t, prometheus_var_lib_t)
manage_files_pattern(prometheus_t, prometheus_var_lib_t, prometheus_var_lib_t)
manage_lnk_files_pattern(prometheus_t, prometheus_var_lib_t, prometheus_var_lib_t)
files_var_lib_filetrans(prometheus_t, prometheus_var_lib_t, dir)
allow prometheus_t prometheus_var_lib_t:file map;

kernel_read_network_state(prometheus_t)

# Go's TCP listener reads /proc/sys/net/core/somaxconn to size the listen backlog.
kernel_read_net_sysctls(prometheus_t)
kernel_read_system_state(prometheus_t)

corenet_tcp_bind_generic_node(prometheus_t)

# Prometheus defaults to TCP 9090. Fedora policy already labels 9090 as
# websm_port_t for Cockpit, so allow binding that existing port type.
corenet_tcp_bind_websm_port(prometheus_t)
corenet_tcp_sendrecv_websm_port(prometheus_t)

dev_read_urand(prometheus_t)

# Prometheus uses statfs(2) on the TSDB path to report filesystem type and size.
fs_getattr_xattr_fs(prometheus_t)

tunable_policy(`prometheus_can_network_connect',`
	corenet_sendrecv_all_client_packets(prometheus_t)
	corenet_tcp_connect_all_ports(prometheus_t)
	corenet_tcp_sendrecv_all_ports(prometheus_t)
')

optional_policy(`
	auth_use_nsswitch(prometheus_t)
')

optional_policy(`
	logging_send_syslog_msg(prometheus_t)
')

optional_policy(`
	miscfiles_read_generic_certs(prometheus_t)
')

optional_policy(`
	sysnet_dns_name_resolve(prometheus_t)
')
