# This file can is used to configure base path aliases as in:
#
# /aliased_path /original_path_as_configured_in_file_contexts
#
# where original_path_as_configured_in_file_contexts is a base
# path being used in the main file_contexts configuration file.
#
# It does not perform substitutions as done by sed(1), for
# example, but aliasing.
#
/var/run /run
/var/lock /run/lock
/run/systemd/system /usr/lib/systemd/system
/run/systemd/generator.early /run/systemd/generator
/run/systemd/generator.late /run/systemd/generator
/lib /usr/lib
/lib64 /usr/lib
/usr/lib64 /usr/lib
/usr/local/lib64 /usr/lib
/usr/local/lib32 /usr/lib
/etc/systemd/system /usr/lib/systemd/system
/etc/systemd/user /usr/lib/systemd/user
/var/lib/xguest/home /home
/var/named/chroot/usr/lib64 /usr/lib
/var/named/chroot/lib64 /usr/lib
/var/named/chroot/var  /var
/home-inst           /home
/home/home-inst      /home
/var/home            /home
/var/roothome        /root
/sbin                /usr/bin
/sysroot/tmp         /tmp
/var/etc             /etc
/var/usrlocal        /usr/local
/var/mnt             /mnt
/bin                 /usr/bin
/usr/etc             /etc
/usr/sbin            /usr/bin
/var/opt             /opt

# systemd system extension (systemd-sysext) staging dirs merge onto /usr and /opt,
# systemd configuration extension (systemd-confext) staging dirs merge onto /etc.
# The staged trees are overlaid onto the host tree with overlayfs, so they must carry
# the same labels the merged paths would have (see systemd-sysext(8)/systemd-confext(8)).
# The trailing "*" is a whole-path-component wildcard: it maps the contents of each
# named extension onto / while leaving the extension directory itself, and the .raw
# disk-image siblings, unmatched. The wildcard is only honoured by libselinux that
# added whole-path-component "*" substitution sources (SELinuxProject/selinux commit
# 3340da2, merged 2026-09-04); earlier restorecon/setfiles/selabel_open refuse the file
# at load time with "'*' ... is not a whole path component".
/var/lib/extensions/* /
/run/extensions/* /
/etc/extensions/* /
/var/lib/confexts/* /
/run/confexts/* /
/usr/lib/confexts/* /
/usr/local/lib/confexts/* /
